# Copy this file to `.env` and fill in your Supabase project details.
# These values are safe to expose to the frontend (they are the anon/public keys).
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Used ONLY by scripts (create-admin, backup). NEVER put these in the frontend.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY
ADMIN_EMAIL=admin@yourinstitute.example
ADMIN_PASSWORD=CHANGE-ME-STRONG-PASSWORD
ADMIN_NAME=Institute Owner